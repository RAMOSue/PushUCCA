# Environment Variables Example
# Copy this to .env and fill in your actual values

# ===== DATABASE (Supabase) =====
DB_USER=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_HOST=YOUR_SUPABASE_HOST.supabase.co
DB_PORT=5432
DB_NAME=postgres

# ===== SERVER =====
PORT=8000
NODE_ENV=development

# ===== JWT =====
JWT_SECRET=your_super_secret_jwt_key_here

# ===== URLs =====
# Local Development
SERVER_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Production (Update after Render deployment)
# SERVER_URL=https://your-backend.onrender.com
# FRONTEND_URL=https://your-frontend.onrender.com

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
# PRODUCTION: https://your-backend.onrender.com/api/auth/google/callback

# ===== EMAIL SERVICE =====
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ===== AI IMAGE RECOGNITION =====
AI_SERVICE_URL=http://127.0.0.1:8000

# ===== WEB PUSH NOTIFICATIONS =====
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your_email@gmail.com
